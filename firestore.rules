rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Beta Signups Collection
    // Allow public write access for beta signup form submissions
    match /beta_signups/{signupId} {
      // Allow anyone to create new beta signups (public form)
      allow create: if
        // Validate email field exists and is a string
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() < 255 &&
        // Validate email format (basic check)
        request.resource.data.email.matches('.*@.*\\..*') &&
        // Validate status field
        request.resource.data.status in ['pending', 'approved', 'rejected'] &&
        // Validate timestamp exists
        request.resource.data.timestamp != null &&
        // Ensure only expected fields are present (prevent spam/abuse)
        request.resource.data.keys().hasOnly(['email', 'status', 'timestamp']);

      // Deny read access (privacy - only admin can read via Firebase Console)
      allow read: if false;

      // Deny updates and deletes from client (only admin via Console)
      allow update, delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
